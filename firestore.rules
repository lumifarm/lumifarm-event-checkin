rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function ticketOwnedByCaller() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    // 活動要幫參加者投保，需要真實姓名、身分證字號、出生年月日都填過才能報名，
    // 跟免費活動價格檢查一樣用 get() 讀使用者自己的文件做確認，不能只信任
    // 前端送來的資料。
    function hasCompleteProfile(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      return u.get('realName', '') != '' &&
        u.get('nationalId', '') != '' &&
        u.get('birthDate', '') != '';
    }
    // 報名時如果宣稱套用了折扣券，必須真的是自己名下、還沒用過的那張，
    // 不能亂填一個 couponId 就折抵，用法跟免費活動的價格檢查一樣是用
    // get() 讀真正的資料做確認，不能只信任前端送來的 discountApplied。
    function usesValidUnusedCoupon(couponId) {
      let c = get(/databases/$(database)/documents/discountCoupons/$(couponId)).data;
      return c.userId == request.auth.uid && c.status == 'unused';
    }

    // 主辦方名單：手動在 Firebase Console 建立文件，文件 ID = 使用者的 uid
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 會員個資：只能看/改自己的，主辦方可讀取所有人、並可更新報到相關欄位
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'photoURL', 'totalEvents', 'realName', 'nationalId', 'birthDate'])) ||
        isAdmin();
    }

    // 活動資訊：所有人可讀，只有主辦方可新增/刪除；報名時允許任何登入者更新名額欄位
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentCount']));
    }

    // 報名票券：本人與主辦方可讀；本人建立自己的票券、只能改繳費狀態；報到狀態只能由主辦方更新
    match /tickets/{ticketId} {
      // resource == null 代表這份票券根本不存在（例如查詢「我是否已報名某活動」時）。
      // 一定要先擋掉這個情況再去讀 resource.data，不然對不存在的文件做 get()
      // 會因為 resource 是 null 而讓整條規則判定失敗，變成登入後任何讀取都被擋。
      allow read: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      // 免費活動（events.price == 0）報名時可以直接把 paymentStatus 建立成
      // 'paid'，不用先走 unpaid → pending → paid；這裡用 get() 去查真正的
      // 活動價格做確認，不能只信任前端送來的資料，不然任何人都能對付費
      // 活動謊報自己已經繳費。
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isCheckedIn == false &&
        request.resource.data.isCancelled == false &&
        hasCompleteProfile(request.auth.uid) &&
        (request.resource.data.get('discountApplied', false) == false ||
          usesValidUnusedCoupon(request.resource.data.couponId)) &&
        (
          request.resource.data.paymentStatus == 'unpaid' ||
          (request.resource.data.paymentStatus == 'paid' &&
            get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('price', 0) == 0)
        );

      allow update: if isAdmin() ||
        // 本人回報已完成匯款，待主辦方對帳；不能直接改成 paid，
        // 也不能對一張已取消的票券這樣做。
        // 用 .get('isCancelled', false) 而不是直接 .isCancelled：
        // 這個欄位是後來才加的，舊票券文件可能根本沒有這個欄位，
        // 直接讀不存在的欄位在規則裡會直接判定失敗（跟讀不存在文件的
        // resource 一樣），要給預設值才能同時相容新舊票券。
        (ticketOwnedByCaller() && resource.data.get('isCancelled', false) != true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'paymentNote', 'paymentSubmittedAt']) &&
          request.resource.data.paymentStatus == 'pending') ||
        // 本人申請取消報名：只是送出申請、進入待審核狀態，還沒真的取消，
        // 名額也還沒釋出——要等主辦方核准（見下面 isAdmin 的分支）才會
        // 把 isCancelled 設成 true。還沒報到、還沒取消過、沒有正在審核中
        // 的申請時才能送出。
        (ticketOwnedByCaller() && resource.data.get('isCheckedIn', false) == false &&
          resource.data.get('isCancelled', false) != true &&
          resource.data.get('cancelRequestStatus', null) != 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['cancelRequestStatus', 'cancelRequestedAt', 'cancelRefundPercent']) &&
          request.resource.data.cancelRequestStatus == 'pending') ||
        // 本人針對「先前取消過的同一張票券」重新報名：整份重置回剛報名的狀態，
        // 但活動不能被換成別的（eventId 必須不變）。跟上面的 create 規則一樣，
        // 免費活動可以直接是 paid，一樣要用 get() 查真正的活動價格做確認。
        (ticketOwnedByCaller() && resource.data.get('isCancelled', false) == true &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.eventId == resource.data.eventId &&
          request.resource.data.isCheckedIn == false &&
          request.resource.data.isCancelled == false &&
          hasCompleteProfile(request.auth.uid) &&
          (request.resource.data.get('discountApplied', false) == false ||
            usesValidUnusedCoupon(request.resource.data.couponId)) &&
          (
            request.resource.data.paymentStatus == 'unpaid' ||
            (request.resource.data.paymentStatus == 'paid' &&
              get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.get('price', 0) == 0)
          ));

      allow delete: if false;
    }

    // 出席折扣券：本人與主辦方可讀自己的那幾張；只有主辦方能發放；本人
    // 報名付費活動時可以把自己「未使用」的那張改成「已使用」（同一次
    // 只能改這三個欄位），其餘異動只有主辦方能做。
    match /discountCoupons/{couponId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
          resource.data.status == 'unused' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedTicketId']) &&
          request.resource.data.status == 'used');
      allow delete: if false;
    }

    // 換工點數異動紀錄：本人與主辦方可讀自己的那幾筆；只有主辦方能新增
    // （發放點數、登記兌換扣點）；紀錄一旦寫入就不能修改或刪除，要更正的話
    // 用再新增一筆補償紀錄的方式，保留完整歷史。
    match /workPointTransactions/{txId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 活動評價：所有人可讀；本人只能新增自己的評價一次，修改/刪除交由主辦方處理
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
  }
}
