rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function ticketOwnedByCaller() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 主辦方名單：手動在 Firebase Console 建立文件，文件 ID = 使用者的 uid
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 會員個資：只能看/改自己的，主辦方可讀取所有人、並可更新報到相關欄位
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'email', 'photoURL', 'totalEvents'])) ||
        isAdmin();
    }

    // 活動資訊：所有人可讀，只有主辦方可新增/刪除；報名時允許任何登入者更新名額欄位
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentCount']));
    }

    // 報名票券：本人與主辦方可讀；本人建立自己的票券、只能改繳費狀態；報到狀態只能由主辦方更新
    match /tickets/{ticketId} {
      // resource == null 代表這份票券根本不存在（例如查詢「我是否已報名某活動」時）。
      // 一定要先擋掉這個情況再去讀 resource.data，不然對不存在的文件做 get()
      // 會因為 resource 是 null 而讓整條規則判定失敗，變成登入後任何讀取都被擋。
      allow read: if isSignedIn() &&
        (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.isCheckedIn == false &&
        request.resource.data.isCancelled == false &&
        request.resource.data.paymentStatus == 'unpaid';

      allow update: if isAdmin() ||
        // 本人回報已完成匯款，待主辦方對帳；不能直接改成 paid，
        // 也不能對一張已取消的票券這樣做。
        (ticketOwnedByCaller() && resource.data.isCancelled != true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['paymentStatus', 'paymentNote', 'paymentSubmittedAt']) &&
          request.resource.data.paymentStatus == 'pending') ||
        // 本人申請取消報名：還沒報到、還沒取消過，只能改這三個欄位，
        // 退款比例由前端依當下日期算好寫入，Firestore 規則不驗證金額邏輯。
        (ticketOwnedByCaller() && resource.data.isCheckedIn == false &&
          resource.data.isCancelled != true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isCancelled', 'cancelledAt', 'refundPercent']) &&
          request.resource.data.isCancelled == true) ||
        // 本人針對「先前取消過的同一張票券」重新報名：整份重置回剛報名的狀態，
        // 但活動不能被換成別的（eventId 必須不變）。
        (ticketOwnedByCaller() && resource.data.isCancelled == true &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.eventId == resource.data.eventId &&
          request.resource.data.isCheckedIn == false &&
          request.resource.data.isCancelled == false &&
          request.resource.data.paymentStatus == 'unpaid');

      allow delete: if false;
    }

    // 活動評價：所有人可讀；本人只能新增自己的評價一次，修改/刪除交由主辦方處理
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }
  }
}
