rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 活動海報：固定存在 event-posters/{eventId}，公開可讀，只有 admins
    // 名單裡的帳號可以上傳/覆蓋/刪除，用 Firestore 的 admins collection
    // 交叉驗證身分（跟 firestore.rules 的 isAdmin() 邏輯一致）。
    match /event-posters/{eventId} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
